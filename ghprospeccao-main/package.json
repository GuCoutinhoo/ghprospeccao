{
  "name": "prospectaplaces-b2b",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build && esbuild src/server/serverless.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "worker": "tsx scripts/search-dispatcher.ts",
    "test": "node --import tsx --import ./tests/setup-env.ts --test --test-concurrency=1 tests/integration.test.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-ghprospeccao --config firebase.test.json \"npm test\"",
    "test:ui": "playwright test",
    "test:supabase": "node --import tsx --test --test-concurrency=1 tests/supabaseAdapter.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-ast": "npm:typescript@^5.9.3"
  }
}
